{
  "name": "validator-brasil",
  "version": "2.1.1",
  "description": "Validações de documentos brasileiros (CPF, CNPJ alfanumérico, CNH, RG, Título de Eleitor, Inscrição Estadual, Pix e mais), compatível com validator.js",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogilvieira/validator-brasil.git"
  },
  "keywords": [
    "validator",
    "brasil",
    "cpf",
    "cnpj",
    "cnpj alfanumerico",
    "renavam",
    "uf",
    "cep",
    "cnh",
    "pix",
    "chave pix",
    "pis",
    "pasep",
    "rg",
    "titulo de eleitor",
    "certidao",
    "inscricao estadual",
    "placa",
    "mercosul",
    "cns",
    "cartao sus"
  ],
  "author": "Gil Vieira <ogilvieira@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ogilvieira/validator-brasil/issues"
  },
  "homepage": "https://github.com/ogilvieira/validator-brasil#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
